<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tasker plugin strings for SimpMusic -->
    <string name="previous_like_value_name">Previous Like Value</string>
    <string name="previous_like_value_description">Previous like status: "true" for liked, "false" for not liked.</string>

    <string name="like_action_name">Like Action</string>
    <string name="like_action_description">Action to perform on the current song: "Like", "Unlike", or "Toggle".</string>

    <string name="song_id_name">Song ID</string>
    <string name="song_id_description">ID of the song to query. Leave empty to use the currently playing song.</string>

    <string name="songinfo_output_song_id_name">Song ID</string>
    <string name="songinfo_output_song_id_description">Unique identifier of the song.</string>

    <string name="songinfo_output_song_title_name">Song Title</string>
    <string name="songinfo_output_song_title_description">Title of the song.</string>

    <string name="songinfo_output_artist_name_name">Artist Name</string>
    <string name="songinfo_output_artist_name_description">Primary artist name for the song.</string>

    <string name="songinfo_output_liked_name">Liked</string>
    <string name="songinfo_output_liked_description">Whether the song is currently marked as liked (true/false).</string>

    <string name="songinfo_output_now_playing_name">Now Playing</string>
    <string name="songinfo_output_now_playing_description">Whether the song is currently playing (true/false).</string>

    <string name="songinfo_output_album_title_name">Album</string>
    <string name="songinfo_output_album_title_description">Album title for the song, if available.</string>

    <string name="songinfo_output_album_id_name">Album ID</string>
    <string name="songinfo_output_album_id_description">Album identifier for the song, if available.</string>

    <string name="songinfo_output_album_year_name">Year</string>
    <string name="songinfo_output_album_year_description">Release year associated with the song or album.</string>

    <string name="command_name">Command</string>
    <string name="command_description">Command to execute</string>

    <string name="out_executed_name">Executed</string>
    <string name="out_executed_description">True if the requested command was executed successfully.</string>

    <string name="tasker_input_playlist_name">Playlist Name</string>
    <string name="tasker_input_playlist_name_description">Name of the playlist to load or manipulate.</string>

    <string name="tasker_input_arg">Argument</string>
    <string name="tasker_input_arg_description">Optional argument used to build or refine the playlist (may be unused for some playlist types).</string>

    <string name="tasker_input_sorting">Sorting</string>
    <string name="tasker_input_sorting_description">Sorting mode applied to the playlist (e.g. Natural, Shuffled).</string>

    <string name="tasker_input_limit">Limit</string>
    <string name="tasker_input_limit_description">Maximum number of songs to add to the queue. Leave empty to add all. Use -1 to enable endless queue (radio mode).</string>
</resources>